# SkySAFE backend / iEP API base URL (no trailing slash).
# In dev, leave unset — Vite proxies /api → http://localhost:8000 to avoid CORS.
# In production, set this to the full backend origin, e.g. https://api.skysafe.caas.gov.sg
VITE_API_BASE_URL=

# ArcGIS Portal URL hosted by iEP
VITE_IEP_PORTAL_URL=

# Portal item ID for the CAAS basemap web scene
VITE_IEP_BASEMAP_ITEM_ID=

# Scene Layer URLs for iEP GIS layers
VITE_IEP_SCENE_BUILDINGS_URL=
VITE_IEP_SCENE_OLS_URL=

# OIDC / Singpass client ID (TBD with CAAS)
VITE_AUTH_CLIENT_ID=
