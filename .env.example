# SkySAFE backend / iEP API base URL (no trailing slash).
# In dev, leave unset — Vite proxies /api → http://localhost:8000 to avoid CORS.
# In production, set this to the full backend origin, e.g. https://api.skysafe.caas.gov.sg
VITE_API_BASE_URL=

# ArcGIS Portal URL hosted by iEP
VITE_IEP_PORTAL_URL=

# Portal item ID for the CAAS basemap web scene
VITE_IEP_BASEMAP_ITEM_ID=

# Scene Layer URLs for iEP GIS layers
VITE_IEP_SCENE_BUILDINGS_URL=
VITE_IEP_SCENE_OLS_URL=

# ─── OIDC / Auth (Keycloak for demo; Singpass/Corppass + AD/OIDC in production) ───
# Keycloak realm URL, e.g. http://localhost:8080/realms/skysafe
VITE_OIDC_AUTHORITY=

# Keycloak client ID configured in the skysafe realm
VITE_OIDC_CLIENT_ID=skysafe-frontend

# ── Keycloak quick-start (local dev) ──────────────────────────────────────────
# docker run -p 8080:8080 \
#   -e KEYCLOAK_ADMIN=admin -e KEYCLOAK_ADMIN_PASSWORD=admin \
#   quay.io/keycloak/keycloak:latest start-dev
#
# Then: create realm "skysafe", add client "skysafe-frontend" (public, SPA),
# set redirect URI to http://localhost:5173/auth/callback,
# add realm roles: public_user | caas_io | adp_ao,
# enable "realm roles" mapper on the client so roles appear in the ID token.
