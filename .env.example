# SkySAFE backend / iEP API base URL (no trailing slash).
# In dev, leave unset — Vite proxies /api → http://localhost:8000 to avoid CORS.
# In production, set this to the full backend origin, e.g. https://api.skysafe.caas.gov.sg
VITE_API_BASE_URL=

# ArcGIS Portal URL hosted by iEP
VITE_IEP_PORTAL_URL=

# Portal item ID for the CAAS basemap web scene
VITE_IEP_BASEMAP_ITEM_ID=

# Scene Layer URLs for iEP GIS layers
VITE_IEP_SCENE_BUILDINGS_URL=
VITE_IEP_SCENE_OLS_URL=

# ─── OIDC / Auth (Keycloak for demo; Singpass/Corppass + AD/OIDC in production) ───
# Keycloak realm URL, e.g. http://localhost:8080/realms/skysafe
VITE_OIDC_AUTHORITY=

# Keycloak client ID configured in the skysafe realm
VITE_OIDC_CLIENT_ID=skysafe-frontend

# ── Keycloak quick-start (local dev) ──────────────────────────────────────────
# docker compose up -d
#   Starts Keycloak on http://localhost:18080 with a persistent named volume
#   (keycloak_data). Admin UI: http://localhost:18080/admin — admin / admin
#
# First-time realm setup (one-off; persists across restarts):
#   1. Create realm: skysafe
#   2. Create client: skysafe-frontend (public, SPA)
#   3. Redirect URI: http://localhost:5173/auth/callback
#   4. Add realm roles: public_user | caas_io | adp_ao
#   5. Enable "realm roles" mapper on the client so roles appear in the ID token
#
# To stop:   docker compose stop
# To destroy (keeps volume): docker compose down
# To destroy + wipe data:    docker compose down -v

# ─── PostgreSQL (for FastAPI backend — NOT exposed to the browser) ─────────────
# These vars are read by the backend API server, not by Vite.
# Do NOT prefix with VITE_ — they must not leak to the client bundle.
#
# docker compose up -d  also starts skysafe-postgres on port 5432.
# The init script (db/init.sql) runs automatically on first start only.
# Data persists in the named volume skysafe_postgres_data across restarts.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skysafe
DB_USER=skysafe
DB_PASSWORD=skysafe_dev
DATABASE_URL=postgresql://skysafe:skysafe_dev@localhost:5432/skysafe
